# IMPORTANTE: Rinomina questo file in .env.local e inserisci i valori reali

# URL del servizio Cloud Run usato dal BROWSER: upload + train-model + training-status
# (OBBLIGATORIO per Training App). Vedi TRAINING_FLOW.md
# Esempio: https://poop-validator-backend-xxxxx-uc.a.run.app
NEXT_PUBLIC_CLOUD_RUN_URL=

# Obbligatorio per POST /api/backfill-features (proxy verso Cloud Run): stesso Bearer
# configurato sul servizio per Authorization su /backfill-features.
# Utile anche per POST /api/retrain se lo usi (path /train).
# CLOUD_RUN_RETRAIN_URL=
CLOUD_RUN_SECRET_KEY=

# Opzionale: override URL solo lato server (default: stesso di NEXT_PUBLIC_CLOUD_RUN_URL)
# CLOUD_RUN_SERVICE_URL=

# Credenziali Supabase (se necessarie per il frontend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Password per accedere alla Training App
NEXT_PUBLIC_TRAINING_PASSWORD=training123
